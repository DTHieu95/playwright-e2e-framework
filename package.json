{
  "name": "saucedemo-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript E2E and API test framework targeting saucedemo.com and restful-booker — portfolio piece showcasing modern POM, fixtures, and CI/CD with live Allure reporting.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test --project=ui-chromium --project=ui-mobile --project=ui-authed --project=api --project=a11y",
    "test:ui": "playwright test --project=ui-chromium",
    "test:mobile": "playwright test --project=ui-mobile",
    "test:api": "playwright test --project=api",
    "test:authed": "playwright test --project=ui-authed",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "docker run --rm -v %cd%:/work -w /work mcr.microsoft.com/playwright:v1.59.1-noble npx playwright test --project=visual-chromium --project=visual-mobile",
    "test:visual:update": "docker run --rm -v %cd%:/work -w /work mcr.microsoft.com/playwright:v1.59.1-noble npx playwright test --project=visual-chromium --project=visual-mobile --update-snapshots",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "allure:gen": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0"
  }
}
